{
  "name": "kamal-health-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "clean": "rm -rf .next .next-dev .next-build",
    "prebuild": "node scripts/prepare-showcase-assets.mjs",
    "predev": "node scripts/prepare-showcase-assets.mjs",
    "test": "tsx --test tests/showcase/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.14.0",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^6.0.0",
    "jspdf": "^4.2.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "overrides": {
